<style>
  .lle-btn{display:inline-flex;align-items:center;gap:10px;background:#0E0E12;color:#E6C77A;border:1px solid #C9A24B;
    padding:14px 26px;font:600 14px/1 'Montserrat',Arial,sans-serif;letter-spacing:.18em;text-transform:uppercase;cursor:pointer;border-radius:2px;transition:.2s}
  .lle-btn:hover{background:#C9A24B;color:#0E0E12}
  .lle-modal{position:fixed;inset:0;z-index:2147483647;display:none;align-items:center;justify-content:center;background:rgba(5,5,8,.88);padding:56px 20px 20px}
  .lle-modal.open{display:flex}
  .lle-box{position:relative;width:100%;max-width:1100px;max-height:100%;overflow:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;background:#08080B;border:1px solid rgba(201,162,75,.4);border-radius:6px}
  .lle-box svg{display:block;width:100%;height:auto}
  .lle-close{position:absolute;top:max(8px,env(safe-area-inset-top));right:14px;width:40px;height:40px;background:none;border:0;color:#F4F1EA;font-size:34px;line-height:1;cursor:pointer;z-index:2}
  body.lle-lock{overflow:hidden}
  @media(max-width:768px){.lle-modal{padding:56px 8px 8px}.lle-note{font-size:12px}.lle-btn{padding:14px 20px;font-size:13px}}
  .lle-tip{position:fixed;pointer-events:none;background:#F4F1EA;color:#0E0E12;font:600 13px 'Montserrat',Arial,sans-serif;padding:6px 10px;border-radius:3px;display:none;z-index:2147483647;white-space:nowrap;max-width:calc(100vw - 16px)}
  .lle-t{cursor:default;transition:opacity .15s}
  .lle-box svg:hover .lle-t{opacity:.45} .lle-box svg .lle-t:hover{opacity:1}
  .lle-note{color:#A6A6B0;font:13px 'Montserrat',Arial,sans-serif;text-align:center;padding:0 16px 18px;margin:0}
</style>

