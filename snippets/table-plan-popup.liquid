<div class="lle-tip" id="lleTip"></div>

<script>
(function(){
  var modal=document.getElementById('lleModal'),tip=document.getElementById('lleTip'),
      box=modal&&modal.querySelector('.lle-box'),
      openBtn=document.getElementById('lleOpen'),closeBtn=document.getElementById('lleClose'),timer;
  if(!modal||!openBtn)return;
  /* move overlay to <body> so no theme container (transform/overflow) can break position:fixed */
  document.body.appendChild(modal);document.body.appendChild(tip);
  function open(){modal.classList.add('open');document.body.classList.add('lle-lock');closeBtn.focus();}
  function hideTip(){clearTimeout(timer);tip.style.display='none';}
  function close(){modal.classList.remove('open');document.body.classList.remove('lle-lock');hideTip();openBtn.focus();}
  openBtn.addEventListener('click',open);
  closeBtn.addEventListener('click',close);
  modal.addEventListener('click',function(e){if(e.target===modal)close();});
  document.addEventListener('keydown',function(e){if(e.key==='Escape'&&modal.classList.contains('open'))close();});

  function setText(g){tip.textContent='Table \u00b7 '+g.dataset.tier;tip.style.display='block';}
  function clamp(v,min,max){return Math.max(min,Math.min(v,max));}
  /* mouse: follow cursor, flip to the left/top if it would leave the screen */
  function placeAtCursor(e){
    var w=tip.offsetWidth,h=tip.offsetHeight,vw=window.innerWidth,vh=window.innerHeight;
    var x=e.clientX+14,y=e.clientY+14;
    if(x+w>vw-8)x=e.clientX-w-14;
    if(y+h>vh-8)y=e.clientY-h-14;
    tip.style.left=clamp(x,8,vw-w-8)+'px';tip.style.top=clamp(y,8,vh-h-8)+'px';
  }
  /* touch: centred under the table, clamped to the screen; above it if there is no room below */
  function placeAtTable(g){
    var r=g.getBoundingClientRect(),w=tip.offsetWidth,h=tip.offsetHeight,vw=window.innerWidth,vh=window.innerHeight;
    var x=r.left+r.width/2-w/2,y=r.bottom+8;
    if(y+h>vh-8)y=r.top-h-8;
    tip.style.left=clamp(x,8,vw-w-8)+'px';tip.style.top=clamp(y,8,vh-h-8)+'px';
  }
  modal.querySelectorAll('.lle-t').forEach(function(g){
    g.addEventListener('pointermove',function(e){if(e.pointerType==='mouse'){setText(g);placeAtCursor(e);}});
    g.addEventListener('pointerleave',function(e){if(e.pointerType==='mouse')hideTip();});
    g.addEventListener('pointerup',function(e){
      if(e.pointerType==='mouse')return;
      setText(g);placeAtTable(g);
      clearTimeout(timer);timer=setTimeout(hideTip,3000);
    });
  });
  /* touch: tap anywhere else or scroll the plan -> hide */
  modal.addEventListener('pointerdown',function(e){if(e.pointerType!=='mouse'&&!e.target.closest('.lle-t'))hideTip();});
  box.addEventListener('scroll',hideTip,{passive:true});
})();
</script>
