<script>
  (function(){
  var tip=document.getElementById('lleTip');
  document.querySelectorAll('#lleModal .lle-t').forEach(function(g){
    g.addEventListener('mousemove',function(e){tip.textContent='Table '+g.dataset.table+' · '+g.dataset.tier;
      tip.style.display='block';tip.style.left=(e.clientX+14)+'px';tip.style.top=(e.clientY+14)+'px';});
    g.addEventListener('mouseleave',function(){tip.style.display='none';});
  });
  document.addEventListener('keydown',function(e){if(e.key==='Escape')document.getElementById('lleModal').classList.remove('open');});
  })();
</script>
